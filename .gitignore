# VF: whitelist — engine snapshot only. Tools, live, archive, and machine paths stay local.

*
!*/

# --- always ---
!.gitignore
!README.md
!_live.target.example

# --- snapshot: /lua run vf ---
!lua/
!lua/vf.lua
!lua/vft.lua
!lua/vfup.lua
!lua/vft/
!lua/vft/**
lua/vft/config/*
!lua/vft/config/.gitkeep
lua/vft/.rev

# --- local / machine ---
_live/
_live.target
client.target
_archive/
tools/
*.log
.lua/
